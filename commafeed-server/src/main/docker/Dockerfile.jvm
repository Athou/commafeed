FROM ibm-semeru-runtimes:open-jdk-25.0.4.10-jre@sha256:c9f7958e38346c5d9e2dd74bd0d7610845a6a2f5fd3bd45cf14acc606359036f
EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
