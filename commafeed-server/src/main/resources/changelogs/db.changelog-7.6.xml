<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="drop-legacy-filtering-expression" author="athou">
        <dropColumn tableName="FEEDSUBSCRIPTIONS" columnName="filtering_expression_legacy"/>
    </changeSet>

    <changeSet id="add-feedentries-content-index" author="athou">
        <createIndex indexName="feedentries_content_index" tableName="FEEDENTRIES">
            <column name="content_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-missing-fk-indexes" author="athou">
        <createIndex indexName="feedsubscriptions_feed_index" tableName="FEEDSUBSCRIPTIONS">
            <column name="feed_id"/>
        </createIndex>
        <createIndex indexName="feedsubscriptions_user_feed_index" tableName="FEEDSUBSCRIPTIONS">
            <column name="user_id"/>
            <column name="feed_id"/>
        </createIndex>
        <createIndex indexName="feedsubscriptions_category_index" tableName="FEEDSUBSCRIPTIONS">
            <column name="category_id"/>
        </createIndex>
        <createIndex indexName="feedentrytags_entry_index" tableName="FEEDENTRYTAGS">
            <column name="entry_id"/>
        </createIndex>
        <createIndex indexName="feedcategories_user_index" tableName="FEEDCATEGORIES">
            <column name="user_id"/>
        </createIndex>
        <createIndex indexName="feedcategories_parent_index" tableName="FEEDCATEGORIES">
            <column name="parent_id"/>
        </createIndex>
        <createIndex indexName="userroles_user_index" tableName="USERROLES">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-feedentries-updated-index" author="athou">
        <createIndex indexName="feedentries_updated_index" tableName="FEEDENTRIES">
            <column name="updated"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
