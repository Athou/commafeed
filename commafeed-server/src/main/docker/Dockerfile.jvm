FROM ibm-semeru-runtimes:open-jdk-25.0.5.0-jre@sha256:bdcbe9886f839d9249d31f8cfc78ff9ff519b0ed54bfb5ec0420be7229be5664

EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
