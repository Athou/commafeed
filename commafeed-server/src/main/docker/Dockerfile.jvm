FROM ibm-semeru-runtimes:open-jdk-25.0.4.0-jre@sha256:043f6729aa35914e2ebf76624e305da7aa5971fc5e8a091c02c45334daa502d8
EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
