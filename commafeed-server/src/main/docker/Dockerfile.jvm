FROM ibm-semeru-runtimes:open-jdk-25.0.4.10-jre@sha256:0ec2b125f2bdf63e0af2ed6caa5d6668ad6f50494674b527ad687c77372a0de1
EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
