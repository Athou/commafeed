FROM ibm-semeru-runtimes:open-jdk-25.0.4.0-jre@sha256:27d848019d486e09b96f104b88213d0c7d0ad6a9f6432c0f1c5a86097aa929c0
EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
