FROM ibm-semeru-runtimes:open-jdk-25.0.4.10-jre@sha256:2b1e6d5818216aede26b58cef8ff8dee1d531c7f40d5bf0db4f70a5f5f19b1cd
EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
