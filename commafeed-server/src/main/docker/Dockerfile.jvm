FROM ibm-semeru-runtimes:open-jdk-25.0.4.15-jre@sha256:80c83b390a2df5bf5dbc0532f46e3a65a680266a3e3b4848f4a442cd66bc2709
EXPOSE 8082

RUN mkdir -p /commafeed/data
VOLUME /commafeed/data

COPY artifacts/extracted-jvm-package/quarkus-app/ /commafeed
WORKDIR /commafeed

CMD ["java", \
    "-Xtune:virtualized", \
    "-Xminf0.05", \
    "-Xmaxf0.1", \
    "-jar", \
    "quarkus-run.jar"]
